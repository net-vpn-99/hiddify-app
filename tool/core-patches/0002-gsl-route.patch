+++ b/v2/config/gsl_route_test.go
@@ -0,0 +1,99 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+)
+
+func writeGsl(t *testing.T, body string) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "gsl-route.json")
+	if err := os.WriteFile(p, []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func TestGslLoadMissing(t *testing.T) {
+	r, err := loadGslRoutes(filepath.Join(t.TempDir(), "nope.json"))
+	if err != nil || !r.empty() {
+		t.Fatalf("missing file: got %+v, %v", r, err)
+	}
+}
+
+func TestGslLoadBad(t *testing.T) {
+	r, err := loadGslRoutes(writeGsl(t, "{not json"))
+	if err == nil || !r.empty() {
+		t.Fatalf("bad json: got %+v, %v", r, err)
+	}
+}
+
+func TestGslDropBadDomains(t *testing.T) {
+	r, _ := loadGslRoutes(writeGsl(t, `{"user_direct":["BTSJ6.com","a b","","*.x.com","1.2.3.4/8",".anycip.com"]}`))
+	got := strings.Join(r.UserDirect, ",")
+	if got != "btsj6.com,anycip.com" {
+		t.Fatalf("user_direct = %q", got)
+	}
+}
+
+func TestGslCap(t *testing.T) {
+	var b strings.Builder
+	b.WriteString(`{"server_proxy":[`)
+	for i := 0; i <= gslMaxDomains; i++ {
+		if i > 0 {
+			b.WriteString(",")
+		}
+		b.WriteString(`"d` + strings.Repeat("x", i%5) + `.example` + string(rune('a'+i%26)) + `.com"`)
+	}
+	b.WriteString(`],"user_direct":["btsj6.com"]}`)
+	r, _ := loadGslRoutes(writeGsl(t, b.String()))
+	if len(r.ServerProxy) != 0 {
+		t.Fatalf("over cap should drop the whole list, got %d", len(r.ServerProxy))
+	}
+	if len(r.UserDirect) != 1 {
+		t.Fatalf("other lists untouched, got %v", r.UserDirect)
+	}
+}
+
+func TestGslRulesOrder(t *testing.T) {
+	r := gslRoutes{
+		UserDirect:   []string{"a.com"},
+		UserProxy:    []string{"b.com"},
+		ServerDirect: []string{"c.com"},
+		ServerProxy:  []string{"d.com"},
+	}
+	_, rules := gslRouteRules(r, &HiddifyOptions{})
+	want := []struct{ dom, out string }{{"a.com", OutboundDirectTag}, {"b.com", OutboundMainDetour}, {"c.com", OutboundDirectTag}, {"d.com", OutboundMainDetour}}
+	if len(rules) != len(want) {
+		t.Fatalf("got %d rules", len(rules))
+	}
+	for i, w := range want {
+		d := rules[i].DefaultOptions
+		if d.DomainSuffix[0] != w.dom || d.RouteOptions.Outbound != w.out || d.Action != C.RuleActionTypeRoute {
+			t.Fatalf("rule %d = %v -> %s", i, d.DomainSuffix, d.RouteOptions.Outbound)
+		}
+	}
+	_, none := gslRouteRules(gslRoutes{UserProxy: []string{"b.com"}}, &HiddifyOptions{})
+	if len(none) != 1 {
+		t.Fatalf("empty lists make no rules, got %d", len(none))
+	}
+}
+
+// 走本地的两份给国内 DNS（拿真 IP，不进假 DNS）；走光速雷达的不加 DNS 规则：
+// 开着假 DNS，节点那头按域名自己解析（补丁 0001 把目的地址换成了域名）。
+func TestGslDnsRules(t *testing.T) {
+	r := gslRoutes{UserDirect: []string{"a.com"}, UserProxy: []string{"b.com"}, ServerDirect: []string{"c.com"}, ServerProxy: []string{"d.com"}}
+	dns, _ := gslRouteRules(r, &HiddifyOptions{})
+	if len(dns) != 2 {
+		t.Fatalf("got %d dns rules", len(dns))
+	}
+	for i, dom := range []string{"a.com", "c.com"} {
+		if dns[i].DomainSuffix[0] != dom || dns[i].RouteOptions.Server != DNSMultiDirectTag {
+			t.Fatalf("dns %d = %v -> %s", i, dns[i].DomainSuffix, dns[i].RouteOptions.Server)
+		}
+	}
+}
