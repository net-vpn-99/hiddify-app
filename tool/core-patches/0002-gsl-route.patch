diff --git a/v2/config/gsl_route.go b/v2/config/gsl_route.go
new file mode 100644
index 0000000..30be8e0
--- /dev/null
+++ b/v2/config/gsl_route.go
@@ -0,0 +1,129 @@
+package config
+
+// OneRay 智能分流（VPN 仓库 docs/计划/智能分流-实施计划-3-安卓.md 任务 1）：
+// App 每次连接前把用户自己改的网站和服务器下发的默认写进工作目录的 gsl-route.json，
+// 这里把四份网址后缀拼成路由规则，插在国内名单前面。文件没有、坏了、太大，一律跳过，照常连。
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"net/netip"
+	"os"
+	"regexp"
+	"strings"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+)
+
+const (
+	gslRouteFile = "gsl-route.json" // 内核启动时已经 chdir 到工作目录
+	// 一份超过这么多整份不收，跟服务器 MAX_LOCKED_DOMAINS、Windows kMaxDefaultSiteDomains 一样
+	gslMaxDomains = 5000
+)
+
+var gslDomainRe = regexp.MustCompile(`^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$`)
+
+type gslRoutes struct {
+	UserDirect   []string `json:"user_direct"`
+	UserProxy    []string `json:"user_proxy"`
+	ServerDirect []string `json:"server_direct"`
+	ServerProxy  []string `json:"server_proxy"`
+}
+
+func (r gslRoutes) empty() bool {
+	return len(r.UserDirect)+len(r.UserProxy)+len(r.ServerDirect)+len(r.ServerProxy) == 0
+}
+
+// 没有文件不算错；读不了、不是 JSON 返回空和错误（调用方打一行日志）。坏网址丢掉，一份超上限整份不收。
+func loadGslRoutes(path string) (gslRoutes, error) {
+	data, err := os.ReadFile(path)
+	if errors.Is(err, fs.ErrNotExist) {
+		return gslRoutes{}, nil
+	}
+	if err != nil {
+		return gslRoutes{}, err
+	}
+	var r gslRoutes
+	if err := json.Unmarshal(data, &r); err != nil {
+		return gslRoutes{}, err
+	}
+	r.UserDirect = gslClean(r.UserDirect)
+	r.UserProxy = gslClean(r.UserProxy)
+	r.ServerDirect = gslClean(r.ServerDirect)
+	r.ServerProxy = gslClean(r.ServerProxy)
+	return r, nil
+}
+
+func gslClean(in []string) []string {
+	if len(in) > gslMaxDomains {
+		return nil
+	}
+	out := make([]string, 0, len(in))
+	seen := map[string]bool{}
+	for _, d := range in {
+		d = strings.TrimPrefix(strings.ToLower(strings.TrimSpace(d)), ".")
+		if !gslDomainRe.MatchString(d) || seen[d] {
+			continue
+		}
+		if _, err := netip.ParseAddr(d); err == nil {
+			continue
+		}
+		seen[d] = true
+		out = append(out, d)
+	}
+	return out
+}
+
+// 路由：用户·走本地 → 用户·走光速雷达 → 服务器·走本地 → 服务器·走光速雷达（跟 Windows 同一顺序）。
+// DNS：只给两份走本地的加国内 DNS（拿真 IP，不进假 DNS）；走光速雷达的不加，节点按域名自己解析。
+func gslRouteRules(r gslRoutes, hopt *HiddifyOptions) ([]option.DefaultDNSRule, []option.Rule) {
+	var dns []option.DefaultDNSRule
+	var rules []option.Rule
+	add := func(domains []string, outbound string) {
+		if len(domains) == 0 {
+			return
+		}
+		rules = append(rules, option.Rule{
+			Type: C.RuleTypeDefault,
+			DefaultOptions: option.DefaultRule{
+				RawDefaultRule: option.RawDefaultRule{DomainSuffix: domains},
+				RuleAction: option.RuleAction{
+					Action:       C.RuleActionTypeRoute,
+					RouteOptions: option.RouteActionOptions{Outbound: outbound},
+				},
+			},
+		})
+		if outbound != OutboundDirectTag {
+			return
+		}
+		dns = append(dns, option.DefaultDNSRule{
+			RawDefaultDNSRule: option.RawDefaultDNSRule{DomainSuffix: domains},
+			DNSRuleAction: option.DNSRuleAction{
+				Action: C.RuleActionTypeRoute,
+				RouteOptions: option.DNSRouteActionOptions{
+					Server:     DNSMultiDirectTag,
+					Strategy:   hopt.DirectDnsDomainStrategy,
+					RewriteTTL: &DEFAULT_DNS_TTL,
+				},
+			},
+		})
+	}
+	add(r.UserDirect, OutboundDirectTag)
+	add(r.UserProxy, OutboundMainDetour)
+	add(r.ServerDirect, OutboundDirectTag)
+	add(r.ServerProxy, OutboundMainDetour)
+	return dns, rules
+}
+
+// setRoutingOptions 里调：读不到就当没有。
+func gslRouteRulesFromFile(hopt *HiddifyOptions) ([]option.DefaultDNSRule, []option.Rule) {
+	r, err := loadGslRoutes(gslRouteFile)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "[gsl-route] skip %s: %v\n", gslRouteFile, err) // 安卓 stdout 没人收，stderr 进工作目录 stderr.log
+		return nil, nil
+	}
+	return gslRouteRules(r, hopt)
+}
