+package gsltransport
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+func envelope() []byte {
+	sub := "vless://11111111-1111-4111-8111-111111111111@node.example:25443?security=tls&type=xhttp&sni=node.example&alpn=h2&mode=stream-one&path=%2Foneray-xhttp%2F#Tokyo\nvless://11111111-1111-4111-8111-111111111111@node.example:24443?security=tls&type=xhttp&sni=node.example&alpn=h3&mode=stream-one&path=%2Foneray-xhttp%2F#Tokyo"
+	v := map[string]any{"schema": 1, "subscription": base64.StdEncoding.EncodeToString([]byte(sub)), "gsl_transports": map[string]any{"schema": 1, "groups": []any{map[string]any{"id": "ln_tokyo", "name": "日本 东京 01 | 标准线路", "revision": 1, "endpoints": []any{map[string]any{"id": "ep_tcp", "host": "node.example", "port": 25443, "kind": "tcp", "available": true}, map[string]any{"id": "ep_udp", "host": "node.example", "port": 24443, "kind": "udp", "available": true}}}}}}
+	b, _ := json.Marshal(v)
+	return b
+}
+func TestGslEnvelopeBindsActualURIs(t *testing.T) {
+	sub, groups, recognized, err := Unwrap(envelope())
+	if err != nil || !recognized || len(groups) != 1 {
+		t.Fatalf("valid metadata rejected: %v", err)
+	}
+	u, parseErr := url.Parse(strings.Split(sub, "\n")[0])
+	if parseErr != nil || !strings.HasPrefix(u.Fragment, EndpointPrefix) || strings.Contains(sub, "#Tokyo") {
+		t.Fatal("actual endpoint identities were not rewritten")
+	}
+	tag := GroupTag(groups[0])
+	g, err := ParseGroupTag(tag)
+	if err != nil || g.ID != "ln_tokyo" || g.Name != "日本 东京 01 | 标准线路" || len(g.Endpoints) != 2 {
+		t.Fatal("group tag lost explicit identity")
+	}
+	if strings.Contains(tag, "11111111-1111") {
+		t.Fatal("group identity leaks account credential")
+	}
+}
+func TestGslInvalidEnvelopeFailsClosed(t *testing.T) {
+	for _, b := range [][]byte{[]byte(strings.Replace(string(envelope()), `"revision":1`, `"revision":0`, 1)), []byte(strings.Replace(string(envelope()), `"ep_udp"`, `"ep_tcp"`, 1)), []byte(strings.Replace(string(envelope()), `"host":"node.example"`, `"host":"unauthorized.example"`, 1)), []byte(strings.Replace(string(envelope()), `"schema":1`, `"schema":9`, 1))} {
+		_, _, recognized, err := Unwrap(b)
+		if !recognized || err == nil {
+			t.Fatal("invalid metadata accepted")
+		}
+	}
+}
+func TestGslLegacyContentUnchanged(t *testing.T) {
+	raw := "dmxlc3M6Ly9leGFtcGxl"
+	s, g, recognized, err := Unwrap([]byte(raw))
+	if s != raw || len(g) != 0 || recognized || err != nil {
+		t.Fatal("legacy input altered")
+	}
+}
+func TestGslMissingRealEndpointCannotBeInvented(t *testing.T) {
+	var v map[string]any
+	json.Unmarshal(envelope(), &v)
+	v["subscription"] = base64.StdEncoding.EncodeToString([]byte("vless://11111111-1111-4111-8111-111111111111@other.example:443#unrelated"))
+	b, _ := json.Marshal(v)
+	_, _, _, err := Unwrap(b)
+	if err == nil {
+		t.Fatal("metadata created an unauthorized endpoint")
+	}
+}
diff --git a/v2/gsltransport/race.go b/v2/gsltransport/race.go
new file mode 100644
--- /dev/null
+++ b/v2/gsltransport/race.go
@@ -0,0 +1,124 @@
+package gsltransport
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"syscall"
+)
+
+type Result struct {
+	State     string `json:"state"`
+	Endpoint  string `json:"endpoint,omitempty"`
+	IP        string `json:"ip,omitempty"`
+	Country   string `json:"country,omitempty"`
+	Reason    string `json:"reason,omitempty"`
+	Operation string `json:"operation,omitempty"`
+}
+type DialFunc func(context.Context, string, string) (net.Conn, error)
+
+// Race has no clock or timeout input: only actual results or caller cancellation decide.
+func Race(parent context.Context, tags []string, request func(context.Context, string) Result) Result {
+	if len(tags) == 0 || len(tags) > 2 {
+		return Result{State: "unconfirmed", Reason: "no_available_endpoint"}
+	}
+	ctx, cancel := context.WithCancel(parent)
+	defer cancel()
+	results := make(chan Result, len(tags))
+	var running sync.WaitGroup
+	for _, tag := range tags {
+		running.Add(1)
+		go func(tag string) { defer running.Done(); results <- request(ctx, tag) }(tag)
+	}
+	defer running.Wait() // Candidate request teardown completes before the caller may commit a winner.
+	failures := 0
+	for i := 0; i < len(tags); i++ {
+		select {
+		case <-parent.Done():
+			cancel()
+			return Result{State: "cancelled"}
+		case r := <-results:
+			if parent.Err() != nil {
+				cancel()
+				return Result{State: "cancelled"}
+			}
+			if r.State == "verified" || r.State == "fatal" {
+				cancel()
+				return r
+			}
+			if r.State == "transport_error" {
+				failures++
+			}
+		}
+	}
+	if failures == len(tags) {
+		return Result{State: "transport_error", Reason: "both_requests_failed"}
+	}
+	return Result{State: "unconfirmed"}
+}
+
+// Verify uses only an explicitly selected real outbound dialer. No URL comes from RPC metadata.
+func Verify(ctx context.Context, tag, expectedCountry string, dial DialFunc) Result {
+	r := Result{State: "unconfirmed", Endpoint: tag}
+	if expectedCountry == "" || expectedCountry == "CN" {
+		r.Reason = "unknown_egress_country"
+		return r
+	}
+	transport := &http.Transport{DialContext: dial, DisableKeepAlives: true, ForceAttemptHTTP2: false, TLSClientConfig: &tls.Config{MinVersion: tls.VersionTLS12}}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, "https://ipinfo.io/json", nil)
+	if err != nil {
+		return r
+	}
+	response, err := client.Do(req)
+	if err != nil {
+		if ctx.Err() != nil {
+			r.State = "cancelled"
+			return r
+		}
+		var authority x509.UnknownAuthorityError
+		var invalid x509.CertificateInvalidError
+		var hostname x509.HostnameError
+		var certificate *tls.CertificateVerificationError
+		if errors.As(err, &authority) || errors.As(err, &invalid) || errors.As(err, &hostname) || errors.As(err, &certificate) {
+			r.State = "fatal"
+			r.Reason = "tls"
+			return r
+		}
+		lower := strings.ToLower(err.Error())
+		if strings.Contains(lower, "authentication failed") || strings.Contains(lower, "invalid user") {
+			r.State = "fatal"
+			r.Reason = "authentication"
+			return r
+		}
+		var dns *net.DNSError
+		if errors.Is(err, syscall.ECONNREFUSED) || errors.Is(err, syscall.ECONNRESET) || errors.Is(err, syscall.ENETUNREACH) || errors.Is(err, syscall.EHOSTUNREACH) || (errors.As(err, &dns) && dns.IsNotFound) {
+			r.State = "transport_error"
+		}
+		return r
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(response.Body, 8193))
+	if err != nil || len(body) > 8192 || response.StatusCode != 200 {
+		return r
+	}
+	var info struct {
+		IP      string `json:"ip"`
+		Country string `json:"country"`
+	}
+	if json.Unmarshal(body, &info) != nil || net.ParseIP(info.IP) == nil || info.Country != expectedCountry || info.Country == "CN" {
+		return r
+	}
+	r.State = "verified"
+	r.IP = info.IP
+	r.Country = info.Country
+	return r
+}
diff --git a/v2/gsltransport/race_test.go b/v2/gsltransport/race_test.go
