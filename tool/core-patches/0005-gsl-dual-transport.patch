+++ b/v2/gsltransport/race_test.go
@@ -0,0 +1,74 @@
+package gsltransport
+
+import (
+	"context"
+	"testing"
+)
+
+func TestGslVerifiedWinnerCancelsUnconfirmedAndWaits(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	ended := make(chan struct{})
+	out := Race(ctx, []string{"tcp", "udp"}, func(ctx context.Context, tag string) Result {
+		if tag == "udp" {
+			return Result{State: "verified", Endpoint: tag, IP: "203.0.113.1", Country: "JP"}
+		}
+		<-ctx.Done()
+		close(ended)
+		return Result{State: "cancelled", Endpoint: tag}
+	})
+	if out.State != "verified" || out.Endpoint != "udp" {
+		t.Fatal(out)
+	}
+	select {
+	case <-ended:
+	default:
+		t.Fatal("winner escaped before losing request ended")
+	}
+}
+func TestGslSilenceIsNotFailure(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	ready := make(chan struct{}, 2)
+	done := make(chan Result, 1)
+	go func() {
+		done <- Race(ctx, []string{"tcp", "udp"}, func(ctx context.Context, tag string) Result {
+			ready <- struct{}{}
+			<-ctx.Done()
+			return Result{State: "cancelled", Endpoint: tag}
+		})
+	}()
+	<-ready
+	<-ready
+	select {
+	case <-done:
+		t.Fatal("silence produced a decision")
+	default:
+	}
+	cancel()
+	if r := <-done; r.State != "cancelled" {
+		t.Fatal(r)
+	}
+}
+func TestGslExplicitSecurityFailureStopsSelection(t *testing.T) {
+	r := Race(context.Background(), []string{"tcp", "udp"}, func(ctx context.Context, tag string) Result {
+		if tag == "tcp" {
+			return Result{State: "fatal", Reason: "tls"}
+		}
+		<-ctx.Done()
+		return Result{State: "cancelled"}
+	})
+	if r.State != "fatal" {
+		t.Fatal(r)
+	}
+}
+func TestGslMixedUnknownDoesNotBecomeBothFailed(t *testing.T) {
+	r := Race(context.Background(), []string{"tcp", "udp"}, func(ctx context.Context, tag string) Result {
+		if tag == "tcp" {
+			return Result{State: "transport_error"}
+		}
+		return Result{State: "unconfirmed"}
+	})
+	if r.State != "unconfirmed" {
+		t.Fatal(r)
+	}
+}
