+++ b/v2/config/gsl_transport_test.go
@@ -0,0 +1,49 @@
+package config
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"github.com/hiddify/hiddify-core/v2/gsltransport"
+	"github.com/sagernet/sing-box/experimental/libbox"
+	"github.com/sagernet/sing-box/option"
+	"strings"
+	"testing"
+)
+
+func TestGslTransportNativeGraphSurvivesBuild(t *testing.T) {
+	yes := true
+	links := "vless://11111111-1111-4111-8111-111111111111@node.example:25443?security=tls&type=xhttp&sni=node.example&alpn=h2&mode=stream-one&path=%2Foneray-xhttp%2F#Tokyo\nvless://11111111-1111-4111-8111-111111111111@node.example:24443?security=tls&type=xhttp&sni=node.example&alpn=h3&mode=stream-one&path=%2Foneray-xhttp%2F#Tokyo"
+	group := gsltransport.Group{ID: "ln_tokyo", Name: "日本 东京 01", Revision: 1, Endpoints: []gsltransport.Endpoint{{ID: "ep_tcp", Host: "node.example", Port: 25443, Kind: "tcp", Available: &yes}, {ID: "ep_udp", Host: "node.example", Port: 24443, Kind: "udp", Available: &yes}}}
+	payload, _ := json.Marshal(map[string]any{"schema": 1, "subscription": base64.StdEncoding.EncodeToString([]byte(links)), "gsl_transports": map[string]any{"schema": 1, "groups": []gsltransport.Group{group}}})
+	input, recognized, err := parseGslEnvelope(libbox.BaseContext(nil), payload, DefaultHiddifyOptions())
+	if err != nil || !recognized {
+		t.Fatalf("real native conversion failed: %v", err)
+	}
+	if len(input.Outbounds) != 3 {
+		t.Fatalf("expected one logical group and two native endpoints, got %d", len(input.Outbounds))
+	}
+	out := &option.Options{}
+	static := map[string][]string{}
+	if err := setOutbounds(out, input, DefaultHiddifyOptions(), &static); err != nil {
+		t.Fatal(err)
+	}
+	groups := 0
+	hidden := 0
+	for _, ob := range out.Outbounds {
+		if strings.HasPrefix(ob.Tag, gsltransport.GroupPrefix) {
+			groups++
+		}
+		if strings.HasPrefix(ob.Tag, gsltransport.EndpointPrefix) {
+			hidden++
+		}
+	}
+	if groups != 1 || hidden != 2 {
+		t.Fatalf("builder lost explicit topology: groups=%d hidden=%d", groups, hidden)
+	}
+	top := out.Outbounds[0].Options.(*option.SelectorOutboundOptions)
+	for _, tag := range top.Outbounds {
+		if strings.HasPrefix(tag, gsltransport.EndpointPrefix) {
+			t.Fatal("physical endpoint leaked into public root selection")
+		}
+	}
+}
diff --git a/v2/hcore/gsl_transport.go b/v2/hcore/gsl_transport.go
new file mode 100644
--- /dev/null
+++ b/v2/hcore/gsl_transport.go
@@ -0,0 +1,115 @@
+package hcore
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/hiddify/hiddify-core/v2/config"
+	"github.com/hiddify/hiddify-core/v2/gsltransport"
+	"github.com/hiddify/hiddify-core/v2/hcommon"
+	"github.com/sagernet/sing-box/protocol/group"
+	M "github.com/sagernet/sing/common/metadata"
+	"net"
+	"strings"
+	"sync"
+)
+
+var gslProbeLock sync.Mutex
+var gslProbeCancel context.CancelFunc
+var gslProbeGeneration uint64
+
+func cancelGslProbe() {
+	gslProbeLock.Lock()
+	defer gslProbeLock.Unlock()
+	gslProbeGeneration++
+	if gslProbeCancel != nil {
+		gslProbeCancel()
+		gslProbeCancel = nil
+	}
+}
+func gslResponse(r gsltransport.Result) *hcommon.Response {
+	b, _ := json.Marshal(r)
+	return &hcommon.Response{Code: hcommon.ResponseCode_OK, Message: string(b)}
+}
+
+// This versioned command reuses UrlTest's existing wire message; it never invokes the old monitor.
+func (h *HiddifyInstance) gslProbe(parent context.Context, command string) (*hcommon.Response, error) {
+	var request struct {
+		Operation string `json:"operation"`
+		Group     string `json:"group"`
+	}
+	if len(command) > 16384 || json.Unmarshal([]byte(strings.TrimPrefix(command, gsltransport.ProbePrefix)), &request) != nil || len(request.Operation) == 0 || len(request.Operation) > 64 {
+		return gslResponse(gsltransport.Result{State: "fatal", Reason: "invalid_probe_request"}), nil
+	}
+	identity, err := gsltransport.ParseGroupTag(request.Group)
+	if err != nil {
+		return gslResponse(gsltransport.Result{State: "fatal", Reason: "invalid_group_identity"}), nil
+	}
+	box := h.Box()
+	if box == nil {
+		return gslResponse(gsltransport.Result{State: "unconfirmed", Operation: request.Operation, Reason: "service_not_ready"}), nil
+	}
+	outerRaw, ok := box.Outbound().Outbound(config.OutboundSelectTag)
+	if !ok {
+		return gslResponse(gsltransport.Result{State: "unconfirmed", Reason: "selector_missing"}), nil
+	}
+	outer, ok := outerRaw.(*group.Selector)
+	if !ok || outer.Now() != request.Group {
+		return gslResponse(gsltransport.Result{State: "cancelled", Operation: request.Operation}), nil
+	}
+	raw, ok := box.Outbound().Outbound(request.Group)
+	if !ok {
+		return gslResponse(gsltransport.Result{State: "fatal", Reason: "group_missing"}), nil
+	}
+	selector, ok := raw.(*group.Selector)
+	if !ok || len(selector.All()) != 2 {
+		return gslResponse(gsltransport.Result{State: "fatal", Reason: "group_not_supported"}), nil
+	}
+	allowed := map[string]bool{}
+	tags := []string{}
+	for _, ep := range identity.Endpoints {
+		allowed[ep.Tag] = true
+		if *ep.Available {
+			tags = append(tags, ep.Tag)
+		}
+	}
+	for _, tag := range selector.All() {
+		if !allowed[tag] {
+			return gslResponse(gsltransport.Result{State: "fatal", Reason: "group_members_changed"}), nil
+		}
+	}
+	ctx, cancel := context.WithCancel(parent)
+	defer cancel()
+	stop := context.AfterFunc(h.Context(), cancel)
+	defer stop()
+	gslProbeLock.Lock()
+	if gslProbeCancel != nil {
+		gslProbeCancel()
+	}
+	gslProbeGeneration++
+	generation := gslProbeGeneration
+	gslProbeCancel = cancel
+	gslProbeLock.Unlock()
+	country := gsltransport.Country(identity.Name)
+	result := gsltransport.Race(ctx, tags, func(ctx context.Context, tag string) gsltransport.Result {
+		outbound, exists := box.Outbound().Outbound(tag)
+		if !exists || outbound.Type() != "vless" {
+			return gsltransport.Result{State: "fatal", Reason: "authorized_outbound_missing"}
+		}
+		return gsltransport.Verify(ctx, tag, country, func(c context.Context, network, address string) (netConn net.Conn, e error) {
+			return outbound.DialContext(c, network, M.ParseSocksaddr(address))
+		})
+	})
+	gslProbeLock.Lock()
+	defer gslProbeLock.Unlock()
+	if generation != gslProbeGeneration || ctx.Err() != nil || h.Box() != box || outer.Now() != request.Group {
+		result = gsltransport.Result{State: "cancelled"}
+	}
+	if result.State == "verified" && !selector.SelectOutbound(result.Endpoint) {
+		result = gsltransport.Result{State: "unconfirmed", Reason: "selection_not_committed"}
+	}
+	if generation == gslProbeGeneration {
+		gslProbeCancel = nil
+	}
+	result.Operation = request.Operation
+	return gslResponse(result), nil
+}
