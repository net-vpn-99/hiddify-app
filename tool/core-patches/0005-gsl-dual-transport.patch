diff --git a/v2/config/gsl_transport.go b/v2/config/gsl_transport.go
new file mode 100644
--- /dev/null
+++ b/v2/config/gsl_transport.go
@@ -0,0 +1,89 @@
+package config
+
+import (
+	"context"
+	"errors"
+	"github.com/hiddify/hiddify-core/v2/gsltransport"
+	"github.com/hiddify/ray2sing/ray2sing"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	"strconv"
+	"strings"
+)
+
+// Only explicitly authorized schema-1 envelopes enter this path; ordinary subscriptions keep their parser.
+func parseGslEnvelope(ctx context.Context, content []byte, opts *HiddifyOptions) (*option.Options, bool, error) {
+	sub, groups, recognized, err := gsltransport.Unwrap(content)
+	if !recognized || err != nil {
+		return nil, recognized, err
+	}
+	native, err := ray2sing.Ray2SingboxOptions(ctx, sub, false)
+	if err != nil {
+		return nil, true, errors.New("authorized transport subscription conversion failed")
+	}
+	wantedTags := map[string]bool{}
+	for _, identity := range groups {
+		for _, ep := range identity.Endpoints {
+			wantedTags[ep.Tag] = true
+		}
+	}
+	byTag := map[string]option.Outbound{}
+	for i, out := range native.Outbounds {
+		// The normal converter appends a numeric group suffix. Resolve only exact expected identities.
+		if at := strings.LastIndex(out.Tag, " § "); at >= 0 && wantedTags[out.Tag[:at]] {
+			if _, err := strconv.Atoi(out.Tag[at+len(" § "):]); err == nil {
+				out.Tag = out.Tag[:at]
+				native.Outbounds[i] = out
+			}
+		}
+		if _, exists := byTag[out.Tag]; exists {
+			return nil, true, errors.New("duplicate converted endpoint tag")
+		}
+		byTag[out.Tag] = out
+	}
+	first := map[string]option.Outbound{}
+	members := map[string]string{}
+	for _, g := range groups {
+		tag := gsltransport.GroupTag(g)
+		tags := []string{}
+		defaultTag := ""
+		for _, ep := range g.Endpoints {
+			out, ok := byTag[ep.Tag]
+			if !ok || out.Type != C.TypeVLESS {
+				return nil, true, errors.New("converted authorized endpoint missing")
+			}
+			v, ok := out.Options.(*option.VLESSOutboundOptions)
+			if !ok || v.TLS == nil || !v.TLS.Enabled || v.TLS.Insecure || v.Transport == nil || v.Transport.Type != "xhttp" || v.Transport.XHTTPOptions.Mode != "stream-one" || v.Transport.XHTTPOptions.Download != nil {
+				return nil, true, errors.New("converted transport security or mode mismatch")
+			}
+			want := "h2"
+			if ep.Kind == "udp" {
+				want = "h3"
+			}
+			if len(v.TLS.ALPN) != 1 || v.TLS.ALPN[0] != want {
+				return nil, true, errors.New("converted transport ALPN mismatch")
+			}
+			tags = append(tags, ep.Tag)
+			members[ep.Tag] = tag
+			if *ep.Available && (defaultTag == "" || ep.Kind == "tcp") {
+				defaultTag = ep.Tag
+			}
+		}
+		if defaultTag == "" {
+			defaultTag = tags[0]
+		}
+		first[tag] = option.Outbound{Type: C.TypeSelector, Tag: tag, Options: &option.SelectorOutboundOptions{Outbounds: tags, Default: defaultTag, InterruptExistConnections: true}}
+	}
+	result := []option.Outbound{}
+	inserted := map[string]bool{}
+	for _, out := range native.Outbounds {
+		if tag, ok := members[out.Tag]; ok && !inserted[tag] {
+			result = append(result, first[tag])
+			inserted[tag] = true
+		}
+		result = append(result, out)
+	}
+	native.Outbounds = result
+	resultOptions, err := patchConfigOptions(ctx, native, "GslTransportParser", opts)
+	return resultOptions, true, err
+}
