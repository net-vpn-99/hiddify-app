+package hcore
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/hiddify/hiddify-core/v2/gsltransport"
+	"github.com/hiddify/hiddify-core/v2/hcommon"
+	"testing"
+)
+
+func TestGslCapabilitiesUsesVersionedDispatch(t *testing.T) {
+	response, err := new(CoreService).UrlTest(context.Background(), &UrlTestRequest{Tag: gsltransport.CapabilitiesTag})
+	if err != nil || response.Code != hcommon.ResponseCode_OK {
+		t.Fatal("capability dispatch failed")
+	}
+	var flags map[string]any
+	if json.Unmarshal([]byte(response.Message), &flags) != nil || flags["schema"] != float64(1) || flags["real_probe"] != true || flags["h3"] != true {
+		t.Fatal("required native transport capability missing")
+	}
+}
+func TestGslMalformedCommandCannotInvokeMonitor(t *testing.T) {
+	response, err := new(CoreService).UrlTest(context.Background(), &UrlTestRequest{Tag: gsltransport.ProbePrefix + "{}"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var result gsltransport.Result
+	if json.Unmarshal([]byte(response.Message), &result) != nil || result.State != "fatal" || result.Reason != "invalid_probe_request" {
+		t.Fatal("malformed command was not rejected")
+	}
+}
diff --git a/v2/gsltransport/model.go b/v2/gsltransport/model.go
new file mode 100644
--- /dev/null
+++ b/v2/gsltransport/model.go
@@ -0,0 +1,235 @@
+// Package gsltransport binds explicit same-node identities to already-authorized links.
+package gsltransport
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+const GroupPrefix = "gsl-ln-v1:"
+const EndpointPrefix = "gsl-ep-v1:"
+const ProbePrefix = "gsl-probe-v1:"
+const CapabilitiesTag = "gsl-capabilities-v1"
+
+type Endpoint struct {
+	ID        string `json:"id"`
+	Host      string `json:"host"`
+	Port      int    `json:"port"`
+	Kind      string `json:"kind"`
+	Available *bool  `json:"available"`
+	Tag       string `json:"tag,omitempty"`
+}
+type Group struct {
+	ID        string     `json:"id"`
+	Name      string     `json:"name"`
+	Revision  int        `json:"revision"`
+	Endpoints []Endpoint `json:"endpoints"`
+}
+type metadata struct {
+	Schema int     `json:"schema"`
+	Groups []Group `json:"groups"`
+}
+type envelopeData struct {
+	Schema       int      `json:"schema"`
+	Subscription string   `json:"subscription"`
+	Metadata     metadata `json:"gsl_transports"`
+}
+
+var identifier = regexp.MustCompile(`^[A-Za-z][A-Za-z0-9_.-]{0,95}$`)
+var uuid = regexp.MustCompile(`(?i)^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+
+func validGroup(g Group) bool {
+	if !identifier.MatchString(g.ID) || g.Revision <= 0 || len(g.Name) == 0 || len(g.Name) > 512 || len(g.Endpoints) != 2 {
+		return false
+	}
+	ids := map[string]bool{}
+	kinds := map[string]bool{}
+	for _, e := range g.Endpoints {
+		if !identifier.MatchString(e.ID) || ids[e.ID] || kinds[e.Kind] || e.Available == nil || e.Host == "" || len(e.Host) > 253 || e.Port <= 0 || e.Port > 65535 || (e.Kind != "tcp" && e.Kind != "udp") {
+			return false
+		}
+		ids[e.ID] = true
+		kinds[e.Kind] = true
+	}
+	return true
+}
+
+// Check duplicate JSON keys and bounded depth before ordinary decoding can hide them.
+func strictJSON(data []byte) error {
+	d := json.NewDecoder(bytes.NewReader(data))
+	var value func(int) error
+	value = func(depth int) error {
+		if depth > 16 {
+			return errors.New("metadata too deep")
+		}
+		token, err := d.Token()
+		if err != nil {
+			return err
+		}
+		if delim, ok := token.(json.Delim); ok {
+			switch delim {
+			case '{':
+				seen := map[string]bool{}
+				for d.More() {
+					k, e := d.Token()
+					if e != nil {
+						return e
+					}
+					key, ok := k.(string)
+					if !ok || seen[key] {
+						return errors.New("duplicate metadata key")
+					}
+					seen[key] = true
+					if err := value(depth + 1); err != nil {
+						return err
+					}
+				}
+			case '[':
+				for d.More() {
+					if err := value(depth + 1); err != nil {
+						return err
+					}
+				}
+			default:
+				return errors.New("unexpected metadata token")
+			}
+			_, err = d.Token()
+			return err
+		}
+		return nil
+	}
+	if err := value(0); err != nil {
+		return err
+	}
+	if _, err := d.Token(); err != io.EOF {
+		return errors.New("trailing metadata")
+	}
+	return nil
+}
+func endpointKey(host string, port int) string {
+	return net.JoinHostPort(strings.ToLower(host), strconv.Itoa(port))
+}
+
+// Unwrap never invents a link from metadata. Invalid recognized envelopes fail closed.
+func Unwrap(data []byte) (string, []Group, bool, error) {
+	raw := string(data)
+	trim := bytes.TrimSpace(data)
+	if len(trim) == 0 || trim[0] != '{' {
+		return raw, nil, false, nil
+	}
+	var marker map[string]json.RawMessage
+	if json.Unmarshal(trim, &marker) != nil {
+		return raw, nil, false, nil
+	}
+	if _, ok := marker["gsl_transports"]; !ok {
+		return raw, nil, false, nil
+	}
+	fail := func() (string, []Group, bool, error) {
+		return "", nil, true, errors.New("invalid authorized transport envelope")
+	}
+	if len(data) > 2*1024*1024 || strictJSON(trim) != nil {
+		return fail()
+	}
+	var v envelopeData
+	if json.Unmarshal(trim, &v) != nil || v.Schema != 1 || v.Metadata.Schema != 1 || len(v.Metadata.Groups) > 256 {
+		return fail()
+	}
+	decoded, err := base64.StdEncoding.DecodeString(v.Subscription)
+	if err != nil {
+		return fail()
+	}
+	lines := strings.Split(strings.ReplaceAll(string(decoded), "\r\n", "\n"), "\n")
+	byAddress := map[string][]int{}
+	urls := map[int]*url.URL{}
+	for i, line := range lines {
+		u, err := url.Parse(strings.TrimSpace(line))
+		if err != nil || u.Scheme != "vless" {
+			continue
+		}
+		port, err := strconv.Atoi(u.Port())
+		if err != nil {
+			continue
+		}
+		key := endpointKey(u.Hostname(), port)
+		byAddress[key] = append(byAddress[key], i)
+		urls[i] = u
+	}
+	groups := v.Metadata.Groups
+	groupIDs := map[string]bool{}
+	endpointIDs := map[string]bool{}
+	used := map[int]bool{}
+	for gi := range groups {
+		g := &groups[gi]
+		if !validGroup(*g) || groupIDs[g.ID] {
+			return fail()
+		}
+		groupIDs[g.ID] = true
+		for ei := range g.Endpoints {
+			ep := &g.Endpoints[ei]
+			indexes := byAddress[endpointKey(ep.Host, ep.Port)]
+			if len(indexes) != 1 || endpointIDs[ep.ID] || used[indexes[0]] {
+				return fail()
+			}
+			i := indexes[0]
+			u := urls[i]
+			q := u.Query()
+			alpn := "h2"
+			if ep.Kind == "udp" {
+				alpn = "h3"
+			}
+			if u.User == nil || !uuid.MatchString(u.User.Username()) || q.Get("security") != "tls" || q.Get("type") != "xhttp" || q.Get("alpn") != alpn || q.Get("flow") != "" || q.Get("allowInsecure") == "1" || q.Get("insecure") == "1" {
+				return fail()
+			}
+			hash := sha256.Sum256([]byte(strings.TrimSpace(lines[i])))
+			ep.Tag = EndpointPrefix + ep.ID + ":" + hex.EncodeToString(hash[:16]) + "§hide§"
+			u.Fragment = ep.Tag
+			u.RawFragment = ""
+			lines[i] = u.String()
+			used[i] = true
+			endpointIDs[ep.ID] = true
+		}
+	}
+	return strings.Join(lines, "\n"), groups, true, nil
+}
+func GroupTag(g Group) string {
+	b, _ := json.Marshal(g)
+	return GroupPrefix + base64.RawURLEncoding.EncodeToString(b)
+}
+func ParseGroupTag(tag string) (Group, error) {
+	var g Group
+	if !strings.HasPrefix(tag, GroupPrefix) || len(tag) > 8192 {
+		return g, errors.New("not a logical transport group")
+	}
+	b, err := base64.RawURLEncoding.DecodeString(strings.TrimPrefix(tag, GroupPrefix))
+	if err != nil || strictJSON(b) != nil {
+		return g, errors.New("invalid group identity")
+	}
+	if json.Unmarshal(b, &g) != nil || !validGroup(g) {
+		return g, errors.New("invalid group identity")
+	}
+	for _, ep := range g.Endpoints {
+		if !strings.HasPrefix(ep.Tag, EndpointPrefix+ep.ID+":") || !strings.HasSuffix(ep.Tag, "§hide§") {
+			return g, fmt.Errorf("invalid endpoint identity")
+		}
+	}
+	return g, nil
+}
+func Country(name string) string {
+	for _, v := range [][2]string{{"日本", "JP"}, {"香港", "HK"}, {"美国", "US"}, {"新加坡", "SG"}, {"韩国", "KR"}, {"台湾", "TW"}, {"英国", "GB"}} {
+		if strings.HasPrefix(name, v[0]) {
+			return v[1]
+		}
+	}
+	return ""
+}
