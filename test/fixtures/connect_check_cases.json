        { "rows": "net+ api+ line+ local+", "fault": "dead_tunnel", "attempt": 2,
          "expect": { "result": "R8", "primary": "switch", "secondary": "contact" } },
        { "rows": "net+ api+ line+ local+", "fault": "dead_tunnel", "attempt": 3,
          "line": "美国 洛杉矶 06", "lineHost": "la06.example", "alt": "日本 东京 03",
          "expect": { "result": "R10", "primary": "contact", "secondary": "recheck" } }
      ]
    },
    {
      "name": "R7 之后只点「重新检查」（中间没有新的连接）：还是 R7，不升成 R8",
