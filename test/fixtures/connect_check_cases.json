{
  "_说明": [
    "连接检查结论表的自动测试情况表（docs/计划/连接检查.md 第六节）。Windows tests/connectcheck_test.cpp 和安卓 test/features/connection/connect_check_verdict_test.dart 都跑这一份。",
    "两个仓库各放一份，内容必须一模一样：VPN 仓库 ui/one-ray/tests/connect_check_cases.json、安卓仓库 test/fixtures/connect_check_cases.json（Windows 测试会比对两份）。改结论表时先改这里，再改两端代码，两端测试都过了才算改完。",
    "每个 case 是一串 steps，共用一份跨次记录（上一次结论、连着几次、不回数据的线路），按顺序跑。platforms 不写 = 两端都跑。",
    "rows：net / api / line / others / local / alt 后面 + = 通过、- = 不通过，没写的行 = 不显示。step 里没写的字段用 defaults。",
    "expect：result 结论编号；primary / secondary 是按钮动作（\"\" = 没有这个按钮）；title / body / primaryText 要求完全一样，bodyHas 只要求包含；{device} 在 Windows 换成「电脑」、安卓换成「手机」。"
  ],
  "defaults": {
    "line": "美国 洛杉矶 05",
    "lineHost": "la05.example",
    "alt": "美国 洛杉矶 06",
    "hasAlt": true,
    "fault": "",
    "connected": false,
    "canRepair": false,
    "conflictText": "",
    "blockSoftware": "",
    "socketsFull": false,
    "attempt": 1
  },
  "cases": [
    {
      "name": "R1 没上网：网络和服务器都碰不到",
      "steps": [{ "rows": "net- api- line- local+", "fault": "dead_tunnel",
        "expect": { "result": "R1", "primary": "recheck", "secondary": "", "title": "这台{device}没连上网" } }]
    },
    {
      "name": "R1 没上网：线路那行通不通都不看",
      "steps": [{ "rows": "net- api- line+ local+",
        "expect": { "result": "R1", "primary": "recheck", "secondary": "" } }]
    },
    {
      "name": "R2 能上网但连不上光速雷达的服务器",
      "steps": [{ "rows": "net+ api- line+ local+",
        "expect": { "result": "R2", "primary": "recheck", "secondary": "site", "title": "连不上光速雷达的服务器", "bodyHas": "这台{device}能上网" } }]
    },
    {
      "name": "R3 Windows：网络被其他软件占用，用失败卡那句话",
      "platforms": ["windows"],
      "steps": [{ "rows": "net+ api+ line+ local-", "conflictText": "你的电脑上还开着 Clash，关掉它光速雷达才能连上。",
        "expect": { "result": "R3", "primary": "conflict", "secondary": "contact", "title": "网络被其他软件占用", "body": "你的电脑上还开着 Clash，关掉它光速雷达才能连上。" } }]
    },
    {
      "name": "R3 Windows：被点了名的安全软件拦住",
      "platforms": ["windows"],
      "steps": [{ "rows": "net+ api+ line- local-", "blockSoftware": "火绒",
        "expect": { "result": "R3", "primary": "trust", "secondary": "contact", "title": "连接被 火绒 拦住了", "body": "把光速雷达加入 火绒 的信任区，再点「重新连接」" } }]
    },
    {
      "name": "R3 Windows：被拦住但认不出是哪个软件",
      "platforms": ["windows"],
      "steps": [{ "rows": "net+ api+ line- local-",
        "expect": { "result": "R3", "primary": "trust", "secondary": "contact", "title": "连接被这台电脑上的软件拦住了" } }]
    },
    {
      "name": "R3 Windows：被拦住时碰哪儿都不通，先认本机，不说成没上网",
      "platforms": ["windows"],
      "steps": [{ "rows": "net- api- line- local-", "blockSoftware": "360",
        "expect": { "result": "R3", "primary": "trust", "secondary": "contact" } }]
    },
    {
      "name": "R3 安卓：开着别的 VPN",
      "platforms": ["android"],
      "steps": [{ "rows": "net+ api+ line+ local-",
        "expect": { "result": "R3", "primary": "vpn_settings", "secondary": "contact", "title": "网络被其他软件占用" } }]
    },
    {
      "name": "R3 安卓：别的 VPN 占着时碰哪儿都不通，先认本机，不说成没上网",
      "platforms": ["android"],
      "steps": [{ "rows": "net- api- line- local-",
        "expect": { "result": "R3", "primary": "vpn_settings", "secondary": "contact" } }]
    },
    {
      "name": "R11 Windows：本机连接数用满，修复帮得上",
      "platforms": ["windows"],
      "steps": [{ "rows": "net- api- line- local+", "socketsFull": true, "canRepair": true,
        "expect": { "result": "R11", "primary": "repair", "secondary": "contact", "title": "这台电脑的网络连接数用满了" } }]
    },
    {
      "name": "R11 Windows：本机连接数用满，修过一次了只给重新连接",
      "platforms": ["windows"],
      "steps": [{ "rows": "net+ api+ line+ local+", "socketsFull": true, "canRepair": false,
        "expect": { "result": "R11", "primary": "reconnect", "secondary": "contact" } }]
    },
    {
      "name": "R11 连接意外断了，修复帮得上",
      "steps": [{ "rows": "net+ api+ line+ local+", "fault": "engine_gone", "canRepair": true,
        "expect": { "result": "R11", "primary": "repair", "secondary": "contact", "title": "光速雷达没能启动连接" } }]
    },
    {
      "name": "连接意外断了但修过一次：不给修复，按查到的走（R7）",
      "steps": [{ "rows": "net+ api+ line+ local+", "fault": "engine_gone", "canRepair": false,
        "expect": { "result": "R7", "primary": "reconnect", "secondary": "switch" } }]
    },
    {
      "name": "连接意外断了、修复帮得上，但这台没联网：先说没联网（修复帮不上；查的几下绕开了光速雷达，不受它影响）",
      "steps": [{ "rows": "net- api- local+", "fault": "engine_gone", "canRepair": true,
        "expect": { "result": "R1", "primary": "recheck", "secondary": "" } }]
    },
    {
      "name": "连接意外断了、修复帮得上，但连不上光速雷达的服务器：先说服务器（R2）",
      "steps": [{ "rows": "net+ api- local+", "fault": "engine_gone", "canRepair": true,
        "expect": { "result": "R2", "primary": "recheck", "secondary": "site" } }]
    },
    {
      "name": "R9 线路设置对不上，有推荐的",
      "steps": [{ "rows": "net+ api+ line+ local+", "fault": "reality_mismatch",
        "expect": { "result": "R9", "primary": "switch", "secondary": "contact", "primaryText": "换到 美国 洛杉矶 06",
          "body": "这条线路的设置和服务器对不上，不是你的问题。请联系客服，我们来处理；你也可以先换一条线路" } }]
    },
    {
      "name": "R9 线路设置对不上，没有可推荐的",
      "steps": [{ "rows": "net+ api+ line+ local+", "fault": "reality_mismatch", "hasAlt": false, "alt": "",
        "expect": { "result": "R9", "primary": "routes", "secondary": "contact", "primaryText": "自己选线路" } }]
    },
    {
      "name": "线路设置对不上但服务器连不上：先说服务器（R2）",
      "steps": [{ "rows": "net+ api- line+ local+", "fault": "reality_mismatch",
        "expect": { "result": "R2", "primary": "recheck", "secondary": "site" } }]
    },
    {
      "name": "R4 线路出了问题：碰不到、其他人也连不上，推荐那条有回应",
      "steps": [{ "rows": "net+ api+ line- others- local+ alt+", "fault": "dead_tunnel",
        "expect": { "result": "R4", "primary": "switch", "secondary": "contact", "title": "美国 洛杉矶 05 出了问题", "bodyHas": "你可以先换到 美国 洛杉矶 06。" } }]
    },
    {
      "name": "R4 线路出了问题：推荐那条也没回应，让他自己选",
      "steps": [{ "rows": "net+ api+ line- others- local+ alt-", "fault": "dead_tunnel",
        "expect": { "result": "R4", "primary": "routes", "secondary": "contact", "bodyHas": "你可以先换一条线路。" } }]
    },
    {
      "name": "R4 碰得到、但他刚才也没连成、其他人也连不上：是线路的问题",
      "steps": [{ "rows": "net+ api+ line+ others- local+ alt+", "fault": "dead_tunnel",
