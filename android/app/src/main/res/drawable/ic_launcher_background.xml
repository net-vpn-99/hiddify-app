<?xml version="1.0" encoding="utf-8"?>
<!-- 珊瑚橙渐变底（左上 #FF8F4A → 右下 #FF4A36），按 108dp 画布中间 72dp 可见区拉渐变 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0" android:color="#FFFF8F4A"/>
                <item android:offset="1" android:color="#FFFF4A36"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- 上沿略亮，跟图标大图的悬浮感一致 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="18"
                android:endX="0"
                android:endY="58">
                <item android:offset="0" android:color="#29FFFFFF"/>
                <item android:offset="1" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
